    "Drop.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can open them in a new window, or in this window instead of what it shows now."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك فتحها في نافذة جديدة، أو في هذه النافذة بدلاً مما تعرضه الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst sie in einem neuen Fenster öffnen oder in diesem Fenster anstelle des aktuellen Inhalts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes abrirlos en una ventana nueva o en esta ventana en lugar de lo que muestra ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez les ouvrir dans une nouvelle fenêtre, ou dans cette fenêtre à la place de son contenu actuel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इन्हें नई विंडो में खोल सकते हैं, या इसी विंडो में अभी दिख रही चीज़ों की जगह।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat membukanya di jendela baru, atau di jendela ini untuk menggantikan isinya sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aprirli in una nuova finestra o in questa finestra al posto di ciò che mostra ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウインドウで開くか、このウインドウで現在の内容の代わりに開くことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 윈도우에서 열거나, 이 윈도우에서 현재 내용 대신 열 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh membukanya dalam tetingkap baharu, atau dalam tetingkap ini menggantikan kandungannya sekarang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt ze openen in een nieuw venster, of in dit venster in plaats van wat het nu toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz otworzyć je w nowym oknie lub w tym oknie zamiast obecnej zawartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode abri-los em uma nova janela ou nesta janela no lugar do que ela mostra agora."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสามารถเปิดในหน้าต่างใหม่ หรือเปิดในหน้าต่างนี้แทนสิ่งที่แสดงอยู่ตอนนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları yeni bir pencerede ya da bu pencerede şu anki içeriğin yerine açabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể mở chúng trong cửa sổ mới, hoặc trong cửa sổ này thay cho nội dung hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在新窗口中打开它们,或在此窗口中打开以替换当前内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在新視窗中打開它們,或在此視窗中打開以取代目前的內容。"
          }
        }
      }
    },
    "Drop.Message.Unsaved" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can open them in a new window, or in this window instead of what it shows now. Opening them in this window discards your unsaved changes."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك فتحها في نافذة جديدة، أو في هذه النافذة بدلاً مما تعرضه الآن. يؤدي فتحها في هذه النافذة إلى تجاهل التغييرات غير المحفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst sie in einem neuen Fenster öffnen oder in diesem Fenster anstelle des aktuellen Inhalts. Wenn du sie in diesem Fenster öffnest, gehen deine nicht gesicherten Änderungen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes abrirlos en una ventana nueva o en esta ventana en lugar de lo que muestra ahora. Si los abres en esta ventana, se descartarán los cambios no guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez les ouvrir dans une nouvelle fenêtre, ou dans cette fenêtre à la place de son contenu actuel. Les ouvrir dans cette fenêtre supprime vos modifications non enregistrées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इन्हें नई विंडो में खोल सकते हैं, या इसी विंडो में अभी दिख रही चीज़ों की जगह। इसी विंडो में खोलने पर आपके बिना सहेजे बदलाव हट जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat membukanya di jendela baru, atau di jendela ini untuk menggantikan isinya sekarang. Membukanya di jendela ini akan membuang perubahan yang belum disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aprirli in una nuova finestra o in questa finestra al posto di ciò che mostra ora. Se li apri in questa finestra, le modifiche non salvate andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウインドウで開くか、このウインドウで現在の内容の代わりに開くことができます。このウインドウで開くと、保存されていない変更は破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 윈도우에서 열거나, 이 윈도우에서 현재 내용 대신 열 수 있습니다. 이 윈도우에서 열면 저장하지 않은 변경 사항이 삭제됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh membukanya dalam tetingkap baharu, atau dalam tetingkap ini menggantikan kandungannya sekarang. Membukanya dalam tetingkap ini akan membuang perubahan yang belum disimpan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt ze openen in een nieuw venster, of in dit venster in plaats van wat het nu toont. Als je ze in dit venster opent, gaan je niet-bewaarde wijzigingen verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz otworzyć je w nowym oknie lub w tym oknie zamiast obecnej zawartości. Otwarcie ich w tym oknie odrzuci niezapisane zmiany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode abri-los em uma nova janela ou nesta janela no lugar do que ela mostra agora. Abri-los nesta janela descarta as alterações não salvas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสามารถเปิดในหน้าต่างใหม่ หรือเปิดในหน้าต่างนี้แทนสิ่งที่แสดงอยู่ตอนนี้ การเปิดในหน้าต่างนี้จะทิ้งการเปลี่ยนแปลงที่ยังไม่ได้บันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları yeni bir pencerede ya da bu pencerede şu anki içeriğin yerine açabilirsiniz. Bu pencerede açmak kaydedilmemiş değişikliklerinizi siler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể mở chúng trong cửa sổ mới, hoặc trong cửa sổ này thay cho nội dung hiện tại. Mở trong cửa sổ này sẽ hủy các thay đổi chưa lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在新窗口中打开它们,或在此窗口中打开以替换当前内容。在此窗口中打开会丢弃未存储的更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
