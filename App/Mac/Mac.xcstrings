    "Settings.StartWithPreviousSelection.Note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag reopens the files or folder you last opened instead of asking you to choose."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد Tunetag فتح الملفات أو المجلد الذي فتحته آخر مرة بدلًا من مطالبتك بالاختيار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag öffnet die zuletzt geöffneten Dateien oder den zuletzt geöffneten Ordner erneut, anstatt dich zur Auswahl aufzufordern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag vuelve a abrir los archivos o la carpeta que abriste por última vez en lugar de pedirte que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag rouvre les fichiers ou le dossier que vous avez ouverts en dernier au lieu de vous demander de faire un choix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag आपसे चुनने के लिए कहने के बजाय आपके द्वारा पिछली बार खोली गई फ़ाइलें या फ़ोल्डर फिर से खोलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag membuka kembali file atau folder yang terakhir Anda buka, alih-alih meminta Anda memilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag riapre i file o la cartella che hai aperto per ultimi invece di chiederti di sceglierli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetagは選択を求める代わりに、最後に開いたファイルまたはフォルダを再度開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag는 선택을 요청하는 대신 마지막으로 열었던 파일 또는 폴더를 다시 엽니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag membuka semula fail atau folder yang terakhir anda buka dan bukannya meminta anda memilih."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag opent de laatst geopende bestanden of map opnieuw in plaats van je te vragen een keuze te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag otwiera ponownie ostatnio otwarte pliki lub folder, zamiast prosić o wybór."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tunetag reabre os arquivos ou a pasta que você abriu por último em vez de pedir que você escolha."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunetag จะเปิดไฟล์หรือโฟลเดอร์ที่คุณเปิดล่าสุดอีกครั้งแทนการขอให้คุณเลือก"
