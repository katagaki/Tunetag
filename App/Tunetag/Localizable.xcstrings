    "TagEditor.Tip.Tokens.Text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك استخدام رموز مختلفة للاستفادة من المعلومات الموجودة (مثل اسم الملف) لتعديل الوسوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können verschiedene Token verwenden, um vorhandene Informationen (z. B. den Dateinamen) zum Bearbeiten Ihrer Tags zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can use various tokens to make use of existing information (such as the file's name) to edit your tags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes usar varios tokens para aprovechar la información existente (como el nombre del archivo) para editar tus etiquetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez utiliser différents jetons pour exploiter les informations existantes (comme le nom du fichier) afin de modifier vos tags."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपने टैग संपादित करने के लिए मौजूदा जानकारी (जैसे फ़ाइल का नाम) का उपयोग करने हेतु विभिन्न टोकन का उपयोग कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat menggunakan berbagai token untuk memanfaatkan informasi yang ada (seperti nama file) untuk mengedit tag Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi usare vari token per sfruttare le informazioni esistenti (come il nome del file) per modificare i tuoi tag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換トークンを利用すると、ファイル名など既存の情報を利用し、より速くタグの情報を記入することができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다양한 토큰을 사용하여 기존 정보(파일 이름 등)를 활용하여 태그를 편집할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh menggunakan pelbagai token untuk memanfaatkan maklumat sedia ada (seperti nama fail) untuk mengedit tag anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt verschillende tokens gebruiken om bestaande informatie (zoals de bestandsnaam) te gebruiken bij het bewerken van je tags."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz używać różnych tokenów, aby wykorzystać istniejące informacje (takie jak nazwa pliku) do edycji tagów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode usar vários tokens para aproveitar informações existentes (como o nome do arquivo) para editar suas tags."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสามารถใช้โทเค็นต่าง ๆ เพื่อใช้ข้อมูลที่มีอยู่ (เช่น ชื่อไฟล์) ในการแก้ไขแท็กของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiketlerinizi düzenlemek için mevcut bilgilerden (dosya adı gibi) yararlanmak üzere çeşitli belirteçler kullanabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể sử dụng các token khác nhau để tận dụng thông tin hiện có (chẳng hạn như tên tệp) để chỉnh sửa thẻ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以使用各种令牌来利用现有信息（例如文件名）来编辑您的标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以使用各種令牌來利用現有資訊（例如檔案名稱）來編輯您的標籤。"
          }
        }
      }
    },
