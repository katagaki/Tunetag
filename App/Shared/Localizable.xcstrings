    "OnlineLookup.Matches.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مطابقة الملفات التي تم التعرّف عليها مع مقاطعها. وتتم مطابقة الملفات الأخرى حسب رقم القرص ورقم المقطع، ثم حسب الترتيب. اضغط على ملف لاختيار مقطع آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkannte Dateien werden ihren Titeln zugeordnet. Andere Dateien werden anhand ihrer CD- und Titelnummern zugeordnet, danach in Reihenfolge. Tippe auf eine Datei, um einen anderen Titel auszuwählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recognized files are matched to their tracks. Other files are matched by their disc and track numbers, then in order. Tap a file to choose a different track."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos reconocidos se asocian a sus pistas. Los demás se asocian por su número de disco y de pista, y después por orden. Toca un archivo para elegir otra pista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers reconnus sont associés à leurs pistes. Les autres fichiers sont associés selon leurs numéros de disque et de piste, puis dans l’ordre. Touchez un fichier pour choisir une autre piste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहचानी गई फ़ाइलों को उनके ट्रैक से मिलाया जाता है। अन्य फ़ाइलों को डिस्क और ट्रैक नंबर से, फिर क्रम से मिलाया जाता है। कोई दूसरा ट्रैक चुनने के लिए फ़ाइल पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File yang dikenali dicocokkan dengan treknya. File lain dicocokkan berdasarkan nomor disk dan nomor trek, lalu berdasarkan urutan. Ketuk file untuk memilih trek lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file riconosciuti vengono abbinati ai rispettivi brani. Gli altri file vengono abbinati in base al numero di disco e di brano, poi in ordine. Tocca un file per scegliere un altro brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認識されたファイルは該当するトラックと照合されます。その他のファイルはディスク番号とトラック番号、次に順番で照合されます。別のトラックを選ぶには、ファイルをタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인식된 파일은 해당 트랙과 연결됩니다. 다른 파일은 디스크 번호와 트랙 번호, 그다음 순서대로 연결됩니다. 다른 트랙을 선택하려면 파일을 탭하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fail yang dikenal pasti dipadankan dengan trek masing-masing. Fail lain dipadankan mengikut nombor cakera dan nombor trek, kemudian mengikut susunan. Ketik fail untuk memilih trek lain."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkende bestanden worden aan hun nummers gekoppeld. Andere bestanden worden gekoppeld op basis van schijf- en tracknummer, daarna op volgorde. Tik op een bestand om een ander nummer te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznane pliki są dopasowywane do ich utworów. Pozostałe pliki są dopasowywane według numeru płyty i utworu, a następnie według kolejności. Stuknij plik, aby wybrać inny utwór."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos reconhecidos são associados às suas faixas. Os demais são associados pelo número do disco e da faixa e, depois, pela ordem. Toque em um arquivo para escolher outra faixa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ที่ระบุได้จะจับคู่กับแทร็กของตน ไฟล์อื่นจะจับคู่ตามหมายเลขดิสก์และหมายเลขแทร็ก จากนั้นตามลำดับ แตะไฟล์เพื่อเลือกแทร็กอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanınan dosyalar kendi parçalarıyla eşleştirilir. Diğer dosyalar önce disk ve parça numaralarına, ardından sıraya göre eşleştirilir. Farklı bir parça seçmek için bir dosyaya dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp được nhận dạng sẽ được ghép với bài hát tương ứng. Các tệp khác được ghép theo số đĩa và số bài, sau đó theo thứ tự. Chạm vào một tệp để chọn bài hát khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已识别的文件会与对应的曲目匹配。其他文件会先按光盘编号和曲目编号、再按顺序匹配。轻点文件可选择其他曲目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已辨識的檔案會與對應的曲目配對。其他檔案會先依光碟編號與曲目編號、再依順序配對。點一下檔案即可選擇其他曲目。"
          }
        }
      }
    },
