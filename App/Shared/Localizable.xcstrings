    "Attributions.DataSources.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يتم توفير الوسوم وصور الألبومات التي يتم البحث عنها عبر الإنترنت بواسطة iTunes وMusicBrainz وCover Art Archive. يتم التعرّف على الأغاني باستخدام Shazam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online gesuchte Tags und Albumcover können von iTunes, MusicBrainz und dem Cover Art Archive stammen. Songs werden mit Shazam erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags and album art looked up online may be provided by iTunes, MusicBrainz, and the Cover Art Archive. Songs are recognized with Shazam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etiquetas y portadas buscadas en línea pueden proceder de iTunes, MusicBrainz y Cover Art Archive. Las canciones se reconocen con Shazam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tags et pochettes recherchés en ligne peuvent provenir d’iTunes, de MusicBrainz et du Cover Art Archive. Les morceaux sont reconnus avec Shazam."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑनलाइन खोजे गए टैग और एल्बम आर्ट iTunes, MusicBrainz और Cover Art Archive से मिल सकते हैं। गाने Shazam से पहचाने जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag dan sampul album yang dicari secara online dapat disediakan oleh iTunes, MusicBrainz, dan Cover Art Archive. Lagu dikenali dengan Shazam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tag e le copertine cercati online possono essere forniti da iTunes, MusicBrainz e Cover Art Archive. I brani vengono riconosciuti con Shazam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインで検索したタグとアートワークは、iTunes、MusicBrainz、Cover Art Archiveから提供される場合があります。曲の認識にはShazamを使用しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인에서 찾은 태그와 앨범 아트는 iTunes, MusicBrainz 및 Cover Art Archive에서 제공될 수 있습니다. 노래는 Shazam으로 인식됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag dan kulit album yang dicari dalam talian mungkin disediakan oleh iTunes, MusicBrainz dan Cover Art Archive. Lagu dikenal pasti dengan Shazam."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online opgezochte tags en albumhoezen kunnen afkomstig zijn van iTunes, MusicBrainz en het Cover Art Archive. Nummers worden herkend met Shazam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagi i okładki wyszukane online mogą pochodzić z iTunes, MusicBrainz i Cover Art Archive. Utwory są rozpoznawane za pomocą Shazam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tags e capas buscadas on-line podem ser fornecidas pelo iTunes, MusicBrainz e Cover Art Archive. As músicas são reconhecidas com o Shazam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แท็กและภาพปกอัลบั้มที่ค้นหาออนไลน์อาจมาจาก iTunes, MusicBrainz และ Cover Art Archive เพลงจะถูกระบุด้วย Shazam"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimiçi aranan etiketler ve albüm kapakları iTunes, MusicBrainz ve Cover Art Archive tarafından sağlanabilir. Şarkılar Shazam ile tanınır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẻ và ảnh bìa album tra cứu trực tuyến có thể được cung cấp bởi iTunes, MusicBrainz và Cover Art Archive. Bài hát được nhận dạng bằng Shazam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在线查找的标签和专辑插图可能由 iTunes、MusicBrainz 和 Cover Art Archive 提供。歌曲通过 Shazam 识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線上查詢的標籤和專輯插圖可能由 iTunes、MusicBrainz 和 Cover Art Archive 提供。歌曲透過 Shazam 辨識。"
          }
        }
      }
    },
