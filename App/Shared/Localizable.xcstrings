        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示檔案名稱中 '-'（破折號）符號之後的文字。例如，\"費玉清 - 一翦梅.mp3\" 將得到 \"一翦梅\"。"
          }
        }
